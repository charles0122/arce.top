{
  "redirects": [
    {
      "source": "/projects",
      "destination": "/project",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/project/:path*",
      "permanent": true
    },
    {
      "source": "/blog/flutter-project-tructure-layer-first-or-features-first",
      "destination": "/blog/flutter-project-structure-layer-first-or-features-first",
      "permanent": true
    },
    {
      "source": "/blog/shader-ui-color-wheer",
      "destination": "/blog/shader-ui-color-wheel",
      "permanent": true
    },
    {
      "source": "/blog/flutter-project-architecure-collection",
      "destination": "/blog/flutter-project-architecture-collection",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/katex/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
